# ===== 云端推理（OpenAI 兼容）=====
CLOUD_LLM_BASE_URL=https://api.dahetao.org/v1
CLOUD_LLM_API_KEY=sk-xxx
CLOUD_LLM_MODEL=qwen3.8-27b
# 整页题目并发请求上限 / 首包前失败重试次数 / 首包与总超时（秒）
CLOUD_CONCURRENCY=8
CLOUD_RETRIES=2
CLOUD_FIRST_TOKEN_TIMEOUT=8
CLOUD_TOTAL_TIMEOUT=40
# 判题始终由云端模型完成，不读取模板答案/解析，不启用本地秒判。

# ===== 手写识别（4090: 本地 vLLM Qwen3.5-2B；Mac 开发: 云端 qwen3-vl-plus）=====
HWR_BASE_URL=https://api.dahetao.org/v1
HWR_API_KEY=sk-xxx
HWR_MODEL=qwen3-vl-plus
# HWR_BASE_URL=http://127.0.0.1:8001/v1
# HWR_API_KEY=EMPTY
# HWR_MODEL=Qwen3.5-2B

# ===== 印刷体 OCR（离线建模板）=====
OCR_BASE_URL=http://127.0.0.1:8002/v1
OCR_MODEL=PaddleOCR-VL-0.9B

# ===== 相机 / 语音 =====
CAMERA_BACKEND=auto
CAMERA_INDEX=0
AUTO_CAPTURE=true
AUTO_GRADE=true
AUTO_STABLE_SECONDS=0.55
AUTO_CHANGE_RATIO=0.045
AUTO_MIN_SHARPNESS=25
# 临时录像默认关闭；当前采集机器显式启用，视频仅存本机，不录音。
RECORDING_ENABLED=false
RECORDING_FPS=15
RECORDING_MAX_SECONDS=60
STT_DEVICE=cpu
TTS_PROVIDER=kokoro
# 保音调语速（Linux需libsonic0）；mock不变速
TTS_SPEED=1.2
# 文字队列的安全上限，不是默认回复目标字数
CHAT_MAX_CHARS=12000
